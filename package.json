{
  "name": "braincoder",
  "version": "0.1.0",
  "private": true,
  "description": "Privacy-first browser toolkit — 123 free developer tools, files never leave your device.",
  "repository": {
    "type": "git",
    "url": "https://github.com/RajaSardar/BrainCoder.git"
  },
  "homepage": "https://braincoder.sardar.dev",
  "bugs": {
    "url": "https://github.com/RajaSardar/BrainCoder/issues"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:e2e": "node e2e/office.mjs",
    "build:core": "cd crates/core && cargo build --release --target wasm32-unknown-unknown && wasm-bindgen --target web --out-name core --out-dir ../../src/lib/core/pkg target/wasm32-unknown-unknown/release/braincoder_core.wasm && wasm-bindgen --target nodejs --out-name core --out-dir ../../e2e/.wasm-node target/wasm32-unknown-unknown/release/braincoder_core.wasm && cp ../../src/lib/core/pkg/core_bg.wasm ../../public/wasm/core_bg.wasm",
    "test:core": "node e2e/wasm-validate.mjs"
  },
  "dependencies": {
    "@pdfsmaller/pdf-decrypt": "^1.0.1",
    "@pdfsmaller/pdf-encrypt": "^1.2.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "cron-parser": "^5.10.0",
    "fflate": "^0.8.3",
    "html2canvas": "^1.4.1",
    "js-yaml": "^5.4.1",
    "lucide-react": "^1.40.0",
    "mammoth": "^1.12.3",
    "marked": "^18.0.12",
    "next": "16.3.4",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "prettier": "^3.9.6",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "smol-toml": "^1.8.0",
    "sql-formatter": "^15.8.2",
    "sql.js": "^1.14.2",
    "tesseract.js": "^7.0.0",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@tailwindcss/postcss": "^4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sql.js": "^1.4.11",
    "@types/turndown": "^5.0.6",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
